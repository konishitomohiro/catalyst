# コピーして .env.local を作り、値を入れる（.env.local はコミットしない）
# Gemini は Vertex AI 経由で呼ぶ。API キーは使わない。
# 手元で動かすときは、先に `gcloud auth application-default login` を実行しておく。

# Google Cloud のプロジェクト ID（クレジットを有効にしたプロジェクト）
GOOGLE_CLOUD_PROJECT=
# Vertex AI の地域。空なら global
GOOGLE_CLOUD_LOCATION=global
# 使うモデル名。Vertex AI のモデル一覧で最新を確認して入れる
GEMINI_MODEL=gemini-2.5-flash
